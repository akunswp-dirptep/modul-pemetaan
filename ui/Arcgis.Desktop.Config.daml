					<group refID="group_pembaruan_znt"/>
					<group refID="group_tool_umum_znt"/>
				</tab>

				<tab id='SistemAplikasi' caption='Penilaian Tanah'>
					<group refID='sistem_aplikasi'/>

				</tab>

			</tabs>
			
			<groups>
			<!-- N B T -->
				<group id="pembuatan_nbt" caption="Pembuatan Nilai Bidang Tanah">
