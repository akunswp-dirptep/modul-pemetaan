          "expression" : "def FindLabel([indeks_sampel], [Nomor_Entry], [nilai]):\n    angka = float(str([nilai]).replace(',', '.'))\n    rupiah = f\"{int(round(angka)):,}\".replace(\",\", \".\")\n\n    return (\n        \"<FNT size='7'>\"\n        \"Indeks: \" + str([indeks_sampel]) + \"\\n\"\n        \"Nomor Entry: \" + str([Nomor_Entry]) + \"\\n\"\n        \"Rp \" + rupiah +\n        \"</FNT>\"\n    )\n    ",
